    <item>
      <title>საწარმოში მომხდარი შემთხვევის შედეგად ახალგაზრდა კაცი დაიღუპა</title>
      <link>https://megatv.ge/%e1%83%a1%e1%83%90%e1%83%ac%e1%83%90%e1%83%a0%e1%83%9b%e1%83%9d%e1%83%a8%e1%83%98-%e1%83%9b%e1%83%9d%e1%83%9b%e1%83%ae%e1%83%93%e1%83%90%e1%83%a0%e1%83%98-%e1%83%a8%e1%83%94%e1%83%9b%e1%83%97%e1%83%ae/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e1%2583%25a1%25e1%2583%2590%25e1%2583%25ac%25e1%2583%2590%25e1%2583%25a0%25e1%2583%259b%25e1%2583%259d%25e1%2583%25a8%25e1%2583%2598-%25e1%2583%259b%25e1%2583%259d%25e1%2583%259b%25e1%2583%25ae%25e1%2583%2593%25e1%2583%2590%25e1%2583%25a0%25e1%2583%2598-%25e1%2583%25a8%25e1%2583%2594%25e1%2583%259b%25e1%2583%2597%25e1%2583%25ae</link>
      <description>ბათუმში ერთ-ერთ საწარმოში მომხდარი შემთხვევის შედეგად ახალგაზრდა კაცი დაიღუპა – ინფორმაციას აჭარა თაიმსი ავრცელებს და წერს, რომ ახალგაზრდა კაცს სამუშაოების შესრულების დროს, სავარაუდოდ, თავში მინა დაეცა, მიღებული დაზიანებების შედეგად კი ადგილზე დაიღუპა. დაღუპული ქობულეთიდან იყო და ბათუმში მუშაობდა</description>
      <guid isPermaLink="false">https://megatv.ge/%e1%83%a1%e1%83%90%e1%83%ac%e1%83%90%e1%83%a0%e1%83%9b%e1%83%9d%e1%83%a8%e1%83%98-%e1%83%9b%e1%83%9d%e1%83%9b%e1%83%ae%e1%83%93%e1%83%90%e1%83%a0%e1%83%98-%e1%83%a8%e1%83%94%e1%83%9b%e1%83%97%e1%83%ae/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e1%2583%25a1%25e1%2583%2590%25e1%2583%25ac%25e1%2583%2590%25e1%2583%25a0%25e1%2583%259b%25e1%2583%259d%25e1%2583%25a8%25e1%2583%2598-%25e1%2583%259b%25e1%2583%259d%25e1%2583%259b%25e1%2583%25ae%25e1%2583%2593%25e1%2583%2590%25e1%2583%25a0%25e1%2583%2598-%25e1%2583%25a8%25e1%2583%2594%25e1%2583%259b%25e1%2583%2597%25e1%2583%25ae</guid>
