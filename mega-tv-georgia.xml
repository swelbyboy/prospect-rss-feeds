      <title>“პრეზიდენტის საქმეა ჰქონდა თუ არა კონსულტაციები”- გია ვოლსკი</title>
      <link>https://megatv.ge/%e1%83%9e%e1%83%a0%e1%83%94%e1%83%96%e1%83%98%e1%83%93%e1%83%94%e1%83%9c%e1%83%a2%e1%83%98%e1%83%a1-%e1%83%a1%e1%83%90%e1%83%a5%e1%83%9b%e1%83%94%e1%83%90-%e1%83%b0%e1%83%a5%e1%83%9d%e1%83%9c/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e1%2583%259e%25e1%2583%25a0%25e1%2583%2594%25e1%2583%2596%25e1%2583%2598%25e1%2583%2593%25e1%2583%2594%25e1%2583%259c%25e1%2583%25a2%25e1%2583%2598%25e1%2583%25a1-%25e1%2583%25a1%25e1%2583%2590%25e1%2583%25a5%25e1%2583%259b%25e1%2583%2594%25e1%2583%2590-%25e1%2583%25b0%25e1%2583%25a5%25e1%2583%259d%25e1%2583%259c</link>
      <description>მან [მიხეილ ყაველაშვილმა] იცის ოპოზიციის, ხელისუფლების, რევოლუციური კომიტეტის პოზიცია და დარწმუნებული ვარ, რომ სწორ გადაწყვეტილებას მიიღებს, – ამის შესახებ პარლამენტის პირველმა ვიცე-სპიკერმა, გია ვოლსკიმ ჟურნალისტებთან აქციების პერიოდში დაკავებული პირების შესაძლო შეწყალებაზე დასმული კითხვის საპასუხოდ განაცხადა. მისი თქმით, აქციაზე დაკავებული ადამიანების მხრიდან სინანულზე, რასაც შეწყალება უნდა მოჰყვებოდეს, საუბარი არ არის. „ამ პროცესების დროს ექსტრემისტული გამოვლინებების პროცესში დაკავებული ადამი</description>
      <guid isPermaLink="false">https://megatv.ge/%e1%83%9e%e1%83%a0%e1%83%94%e1%83%96%e1%83%98%e1%83%93%e1%83%94%e1%83%9c%e1%83%a2%e1%83%98%e1%83%a1-%e1%83%a1%e1%83%90%e1%83%a5%e1%83%9b%e1%83%94%e1%83%90-%e1%83%b0%e1%83%a5%e1%83%9d%e1%83%9c/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e1%2583%259e%25e1%2583%25a0%25e1%2583%2594%25e1%2583%2596%25e1%2583%2598%25e1%2583%2593%25e1%2583%2594%25e1%2583%259c%25e1%2583%25a2%25e1%2583%2598%25e1%2583%25a1-%25e1%2583%25a1%25e1%2583%2590%25e1%2583%25a5%25e1%2583%259b%25e1%2583%2594%25e1%2583%2590-%25e1%2583%25b0%25e1%2583%25a5%25e1%2583%259d%25e1%2583%259c</guid>
      <pubDate>Mon, 19 Jan 2026 11:14:52 +0000</pubDate>
