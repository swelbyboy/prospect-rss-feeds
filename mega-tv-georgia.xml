    <item>
      <title>პროკურატურა ინფორმაციას ავრცელებს</title>
      <link>https://megatv.ge/%e1%83%9e%e1%83%a0%e1%83%9d%e1%83%99%e1%83%a3%e1%83%a0%e1%83%90%e1%83%a2%e1%83%a3%e1%83%a0%e1%83%90-%e1%83%98%e1%83%9c%e1%83%a4%e1%83%9d%e1%83%a0%e1%83%9b%e1%83%90%e1%83%aa%e1%83%98%e1%83%90-10/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e1%2583%259e%25e1%2583%25a0%25e1%2583%259d%25e1%2583%2599%25e1%2583%25a3%25e1%2583%25a0%25e1%2583%2590%25e1%2583%25a2%25e1%2583%25a3%25e1%2583%25a0%25e1%2583%2590-%25e1%2583%2598%25e1%2583%259c%25e1%2583%25a4%25e1%2583%259d%25e1%2583%25a0%25e1%2583%259b%25e1%2583%2590%25e1%2583%25aa%25e1%2583%2598%25e1%2583%2590-10</link>
      <description>საქართველოს პროკურატურამ განსაკუთრებით დიდი ოდენობით ფსიქოტროპული ნივთიერების უკანონო შეძენის, შენახვის და საქართველოში უკანონოდ შემოტანის ფაქტზე უცხო ქვეყნის მოქალაქეს ბრალდება წარუდგინა. შინაგან საქმეთა სამინისტროს მიერ ჩატარებული გამოძიებით დადგინდა, რომ ბრალდებულმა საზღვარგარეთ ყოფნისას, უკანონოდ შეიძინა და ინახავდა განსაკუთრებით დიდი ოდენობით 809 აბი ფსიქოტროპულ ნივთიერება „პრეგაბალინს“, რომელიც თბილისის საერთაშორისო აეროპორტის სასაზღვრო-გამშვები პუნქტის გამოვლით უკანონოდ შემოიტანა საქართვე</description>
      <guid isPermaLink="false">https://megatv.ge/%e1%83%9e%e1%83%a0%e1%83%9d%e1%83%99%e1%83%a3%e1%83%a0%e1%83%90%e1%83%a2%e1%83%a3%e1%83%a0%e1%83%90-%e1%83%98%e1%83%9c%e1%83%a4%e1%83%9d%e1%83%a0%e1%83%9b%e1%83%90%e1%83%aa%e1%83%98%e1%83%90-10/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e1%2583%259e%25e1%2583%25a0%25e1%2583%259d%25e1%2583%2599%25e1%2583%25a3%25e1%2583%25a0%25e1%2583%2590%25e1%2583%25a2%25e1%2583%25a3%25e1%2583%25a0%25e1%2583%2590-%25e1%2583%2598%25e1%2583%259c%25e1%2583%25a4%25e1%2583%259d%25e1%2583%25a0%25e1%2583%259b%25e1%2583%2590%25e1%2583%25aa%25e1%2583%2598%25e1%2583%2590-10</guid>
