      <enclosure url="https://static.asianetnews.com/images/w-1280,h-720,format-jpg,imgid-01kfwzf96fkz1tvs8fdjy8bgsr,imgname-orange2-1769425315023.jpg" length="0" type="image/jpeg"/>
