      <guid isPermaLink="false">https://www.azatutyun.am/a/araghchin-haytnel-e-or-amn-i-het-mijoukayin-banaktsoutyounneroum-divanagitakan-loutsman-mets-hnaravoroutyoun-ka/33685121.html</guid>
