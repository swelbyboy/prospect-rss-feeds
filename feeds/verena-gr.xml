      <description>&amp;lt;p&amp;gt;&amp;lt;strong&amp;gt;&amp;lt;u&amp;gt;ΔΕΛΤΙΟ ΤΥΠΟΥ&amp;lt;/u&amp;gt;&amp;lt;/strong&amp;gt;&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;&amp;lt;strong&amp;gt;Εκπαιδευτική δράση της ΔΑΝΑΕΚΚ στο 2ο Δημοτικό Σχολείο Αφάντου&amp;lt;/strong&amp;gt;&amp;lt;/p&amp;gt; &amp;lt;p&amp;gt;Στο πλαίσιο των δράσεων της για την ενημέρωση και την ευαισθητοποίηση της εκπαιδευτικής κοινότητας και των μαθητών σε θέματα περιβάλλοντος και ανακύκλωσης, η &amp;lt;strong&amp;gt;Δωδεκανησιακή Ανακύκλωση ΑΕΚΚ&amp;lt;/strong&amp;gt; με διακριτικό τίτλο &amp;lt;strong&amp;gt;ΔΑΝΑΕΚΚ&amp;lt;/strong&amp;gt; πραγματοποίησε την Τετάρτη 21/1/2026 ενημερωτική και εκπαιδευτική παρουσίαση στο 2ο Δημοτικό Σχολείο Αφάντου.&amp;lt;/p&amp;gt; &amp;lt;p</description>
      <guid isPermaLink="false">https://verena.gr/content/%CE%B5%CE%BA%CF%80%CE%B1%CE%B9%CE%B4%CE%B5%CF%85%CF%84%CE%B9%CE%BA%CE%AE-%CE%B4%CF%81%CE%AC%CF%83%CE%B7-%CF%84%CE%B7%CF%82-%CE%B4%CE%B1%CE%BD%CE%B1%CE%B5%CE%BA%CE%BA-%CF%83%CF%84%CE%BF-2%CE%BF-%CE%B4%CE%B7%CE%BC%CE%BF%CF%84%CE%B9%CE%BA%CF%8C-%CF%83%CF%87%CE%BF%CE%BB%CE%B5%CE%AF%CE%BF-%CE%B1%CF%86%CE%AC%CE%BD%CF%84%CE%BF%CF%85</guid>
      <enclosure url="https://verena.gr/sites/default/files/styles/large/public/field/image/sxoleio-dannaekk1.png?itok=sIhyUhIv" length="0" type="image/jpeg"/>
      <pubDate>Tue, 27 Jan 2026 15:28:33 +0000</pubDate>
