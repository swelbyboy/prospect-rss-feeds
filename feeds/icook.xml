      <enclosure url="https://imgproxy.icook.network/safe/rs:fill:1200:0:0:0/q:80/plain/http://tokyo-kitchen.icook.tw.s3.amazonaws.com/uploads/recipe/cover/485201/3e4b0c4f4a685aa8.jpg" length="0" type="image/jpeg"/>
