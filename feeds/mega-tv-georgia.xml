    <item>
      <title>პოლიციამ არასრულწლოვანი შშმ პირის გაუპატიურების ბრალდებით ტაქსის მძღოლი დააკავა</title>
      <link>https://megatv.ge/%e1%83%9e%e1%83%9d%e1%83%9a%e1%83%98%e1%83%aa%e1%83%98%e1%83%90%e1%83%9b-%e1%83%90%e1%83%a0%e1%83%90%e1%83%a1%e1%83%a0%e1%83%a3%e1%83%9a%e1%83%ac%e1%83%9a%e1%83%9d%e1%83%95%e1%83%90%e1%83%9c-2/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e1%2583%259e%25e1%2583%259d%25e1%2583%259a%25e1%2583%2598%25e1%2583%25aa%25e1%2583%2598%25e1%2583%2590%25e1%2583%259b-%25e1%2583%2590%25e1%2583%25a0%25e1%2583%2590%25e1%2583%25a1%25e1%2583%25a0%25e1%2583%25a3%25e1%2583%259a%25e1%2583%25ac%25e1%2583%259a%25e1%2583%259d%25e1%2583%2595%25e1%2583%2590%25e1%2583%259c-2</link>
      <description>პოლიციამ არასრულწლოვანი შშმ პირის გაუპატიურების ბრალდებით ტაქსის მძღოლი დააკავა. -. “შინაგან საქმეთა სამინისტროს შიდა ქართლის პოლიციის დეპარტამენტის გორის რაიონული სამმართველოს თანამშრომლებმა, წინასწარი შეცნობით არასრულწლოვანის გაუპატიურების ბრალდებით 1980 წელს დაბადებული მ.b. დააკავეს. გამოძიებით დადგინდა, რომ ბრალდებულმა ტაქსის მძღოლმა, გორის მუნიციპალიტეტში არსებულ ტყის მასივში, შეზღუდული შესაძლებლობების სტატუსის მქონე მოზარდზე სექსუალურად იძალადა. ჩატარებული ოპერატიული ღონისძიებებისა და საგა</description>
      <guid isPermaLink="false">https://megatv.ge/%e1%83%9e%e1%83%9d%e1%83%9a%e1%83%98%e1%83%aa%e1%83%98%e1%83%90%e1%83%9b-%e1%83%90%e1%83%a0%e1%83%90%e1%83%a1%e1%83%a0%e1%83%a3%e1%83%9a%e1%83%ac%e1%83%9a%e1%83%9d%e1%83%95%e1%83%90%e1%83%9c-2/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e1%2583%259e%25e1%2583%259d%25e1%2583%259a%25e1%2583%2598%25e1%2583%25aa%25e1%2583%2598%25e1%2583%2590%25e1%2583%259b-%25e1%2583%2590%25e1%2583%25a0%25e1%2583%2590%25e1%2583%25a1%25e1%2583%25a0%25e1%2583%25a3%25e1%2583%259a%25e1%2583%25ac%25e1%2583%259a%25e1%2583%259d%25e1%2583%2595%25e1%2583%2590%25e1%2583%259c-2</guid>
