    <item>
      <title>რუბიოს გზავნილი ოპტიმიზმის საფუძველს გვაძლევს – კობახიძე</title>
      <link>https://megatv.ge/%e1%83%a0%e1%83%a3%e1%83%91%e1%83%98%e1%83%9d%e1%83%a1-%e1%83%92%e1%83%96%e1%83%90%e1%83%95%e1%83%9c%e1%83%98%e1%83%9a%e1%83%98-%e1%83%9d%e1%83%9e%e1%83%a2%e1%83%98%e1%83%9b%e1%83%98%e1%83%96%e1%83%9b/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e1%2583%25a0%25e1%2583%25a3%25e1%2583%2591%25e1%2583%2598%25e1%2583%259d%25e1%2583%25a1-%25e1%2583%2592%25e1%2583%2596%25e1%2583%2590%25e1%2583%2595%25e1%2583%259c%25e1%2583%2598%25e1%2583%259a%25e1%2583%2598-%25e1%2583%259d%25e1%2583%259e%25e1%2583%25a2%25e1%2583%2598%25e1%2583%259b%25e1%2583%2598%25e1%2583%2596%25e1%2583%259b</link>
      <description>[მარკო] რუბიოს გზავნილი ოპტიმიზმის საფუძველს გვაძლევს, ჩვენი მხრიდან გამოხატული იქნება სრული ღიაობა სტრატეგიული პარტნიორობის აღდგენასთან დაკავშირებით ,- ამის შესახებ პრემიერმა, ირაკლი კობახიძემ ბრიფინგზე განაცხადა. აღნიშნულით მან აშშ-ს სახელმწიფო მდივან მარკო რუბიოსა და მიხეილ ყაველაშვილს შორის შეხვედრაზე გაჟღერებული გზავნილების შეფასებისას განაცხადა. „რა თქმა უნდა, ეს გზავნილი გვაძლევს ოპტიმიზმის საფუძველს. ჩვენი განაცხადი ცნობილია, ჩვენი სურვილია სუფთა ფურცლიდან, კონკრეტული გზამკვლევით აღვადგი</description>
      <guid isPermaLink="false">https://megatv.ge/%e1%83%a0%e1%83%a3%e1%83%91%e1%83%98%e1%83%9d%e1%83%a1-%e1%83%92%e1%83%96%e1%83%90%e1%83%95%e1%83%9c%e1%83%98%e1%83%9a%e1%83%98-%e1%83%9d%e1%83%9e%e1%83%a2%e1%83%98%e1%83%9b%e1%83%98%e1%83%96%e1%83%9b/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e1%2583%25a0%25e1%2583%25a3%25e1%2583%2591%25e1%2583%2598%25e1%2583%259d%25e1%2583%25a1-%25e1%2583%2592%25e1%2583%2596%25e1%2583%2590%25e1%2583%2595%25e1%2583%259c%25e1%2583%2598%25e1%2583%259a%25e1%2583%2598-%25e1%2583%259d%25e1%2583%259e%25e1%2583%25a2%25e1%2583%2598%25e1%2583%259b%25e1%2583%2598%25e1%2583%2596%25e1%2583%259b</guid>
      <pubDate>Mon, 09 Feb 2026 13:59:42 +0000</pubDate>
