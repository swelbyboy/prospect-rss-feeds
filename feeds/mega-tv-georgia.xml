    <item>
      <title>რა შემთხვევაში მოხდება სტუდენტთა გამონაკლისის სახით ჩარიცხვა უნივერსიტეტებში – მინისტრის განმარტება</title>
      <link>https://megatv.ge/%e1%83%a0%e1%83%90-%e1%83%a8%e1%83%94%e1%83%9b%e1%83%97%e1%83%ae%e1%83%95%e1%83%94%e1%83%95%e1%83%90%e1%83%a8%e1%83%98-%e1%83%9b%e1%83%9d%e1%83%ae%e1%83%93%e1%83%94%e1%83%91%e1%83%90-%e1%83%a1/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e1%2583%25a0%25e1%2583%2590-%25e1%2583%25a8%25e1%2583%2594%25e1%2583%259b%25e1%2583%2597%25e1%2583%25ae%25e1%2583%2595%25e1%2583%2594%25e1%2583%2595%25e1%2583%2590%25e1%2583%25a8%25e1%2583%2598-%25e1%2583%259b%25e1%2583%259d%25e1%2583%25ae%25e1%2583%2593%25e1%2583%2594%25e1%2583%2591%25e1%2583%2590-%25e1%2583%25a1</link>
      <description>საქართველოს განათლების, მეცნიერებისა და ახალგაზრდობის მინისტრმა, გივი მიქანაძემ განმარტა, რა შემთხვევაში მოხდება უნივერსიტეტებში სტუდენტთა ჩარიცხვა გამონაკლისის სახით. მინისტრის თქმით, დადგენილ კვოტებზე დამატებით სტუდენტთა მიღება გამონაკლისის სახით შეიძლება მოხდეს იმ შემთხვევაში: თუ ერთიანი ეროვნული გამოცდების შედეგად ბოლო ადგილზე მოხვდა თანაბარი ქულების მქონე ორი ან მეტი სტუდენტი; თუ საქართველოს დროებით ოკუპირებულ ტერიტორიებზე მცხოვრები პირები ერთიანი ეროვნული გამოცდების […]</description>
      <guid isPermaLink="false">https://megatv.ge/%e1%83%a0%e1%83%90-%e1%83%a8%e1%83%94%e1%83%9b%e1%83%97%e1%83%ae%e1%83%95%e1%83%94%e1%83%95%e1%83%90%e1%83%a8%e1%83%98-%e1%83%9b%e1%83%9d%e1%83%ae%e1%83%93%e1%83%94%e1%83%91%e1%83%90-%e1%83%a1/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e1%2583%25a0%25e1%2583%2590-%25e1%2583%25a8%25e1%2583%2594%25e1%2583%259b%25e1%2583%2597%25e1%2583%25ae%25e1%2583%2595%25e1%2583%2594%25e1%2583%2595%25e1%2583%2590%25e1%2583%25a8%25e1%2583%2598-%25e1%2583%259b%25e1%2583%259d%25e1%2583%25ae%25e1%2583%2593%25e1%2583%2594%25e1%2583%2591%25e1%2583%2590-%25e1%2583%25a1</guid>
