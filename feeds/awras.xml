    <item>
      <title>هل يُجهز ليفربول حاج موسى لخلافة محمد صلاح؟</title>
      <link>https://www.awras.com/%d9%87%d9%84-%d9%8a%d9%8f%d8%ac%d9%87%d8%b2-%d9%84%d9%8a%d9%81%d8%b1%d8%a8%d9%88%d9%84-%d8%ad%d8%a7%d8%ac-%d9%85%d9%88%d8%b3%d9%89-%d9%84%d8%ae%d9%84%d8%a7%d9%81%d8%a9-%d9%85%d8%ad%d9%85%d8%af-%d8%b5/</link>
