      <enclosure url="https://media.ouest-france.fr/v1/pictures/MjAyNjAyYzA4M2JhNTE2OTQyMDBmZWRkYThlMTdiYzM1ZDg4YzY?width=320&amp;height=240&amp;focuspoint=50%2C25&amp;cropresize=1&amp;client_id=bpeditorial&amp;sign=905c8d0fa3bc94f81f65c8ea4ccdf0799db870565052fe1bd7efff2d770ce117" length="0" type="image/jpeg"/>
