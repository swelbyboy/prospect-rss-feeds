      <link>https://www.aljazeera.net/news/2026/2/19/%d8%b9%d8%a7%d8%ac%d9%84-%d8%ba%d8%a7%d8%b1%d8%a7%d8%aa-%d8%a5%d8%b3%d8%b1%d8%a7%d8%a6%d9%8a%d9%84%d9%8a%d8%a9-%d8%b9%d9%84%d9%89-%d9%85%d9%86%d8%a7%d8%b7%d9%82-%d8%a7%d9%86%d8%aa%d8%b4%d8%a7%d8%b1?traffic_source=rss</link>
