      <title>من غوارديولا إلى كاريك.. هل ثورة المدربين الشباب بالأندية الكبرى رهان مستقبلي أم تقليد أعمى؟</title>
      <link>https://www.aljazeera.net/sport/2026/2/9/%d8%ba%d9%88%d8%a7%d8%b1%d8%af%d9%8a%d9%88%d9%84%d8%a7-%d8%a3%d8%b1%d8%aa%d9%8a%d8%aa%d8%a7-%d9%83%d8%a7%d8%b1%d9%8a%d9%83-%d8%ab%d9%88%d8%b1%d8%a9-%d8%a7%d9%84%d9%85%d8%af%d8%b1%d8%a8%d9%8a%d9%86?traffic_source=rss</link>
