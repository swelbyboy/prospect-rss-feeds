    <item>
      <title>Այս աշխարհէն անշշուկ հեռացած, բայց մնայուն հետքեր ձգած իմ սիրելի ընկերը - Western Armenia TV</title>
      <link>https://westernarmeniatv.com/society_wa/%d5%a1%d5%b5%d5%bd-%d5%a1%d5%b7%d5%ad%d5%a1%d6%80%d5%b0%d5%a7%d5%b6-%d5%a1%d5%b6%d5%b7%d5%b7%d5%b8%d6%82%d5%af-%d5%b0%d5%a5%d5%bc%d5%a1%d6%81%d5%a1%d5%ae-%d5%a2%d5%a1%d5%b5%d6%81-%d5%b4%d5%b6%d5%a1/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25d5%25a1%25d5%25b5%25d5%25bd-%25d5%25a1%25d5%25b7%25d5%25ad%25d5%25a1%25d6%2580%25d5%25b0%25d5%25a7%25d5%25b6-%25d5%25a1%25d5%25b6%25d5%25b7%25d5%25b7%25d5%25b8%25d6%2582%25d5%25af-%25d5%25b0%25d5%25a5%25d5%25bc%25d5%25a1%25d6%2581%25d5%25a1%25d5%25ae-%25d5%25a2%25d5%25a1%25d5%25b5%25d6%2581-%25d5%25b4%25d5%25b6%25d5%25a1</link>
      <description>ՅԱԿՈԲ ԳԱՐԱՔԱՅԱՅԻ ՅԻՇԱՏԱԿԻՆ Անցեալ շաբաթ՝ Նոյեմբեր 20-ին, Յակոբը կնքեց իր մահկանացուն։ Ան ճանաչումի եւ խոր յարգանքի առաւել քան արժանի մարդ մըն էր։ Այս տխուր առիթով կ’ուզեմ քանի մը խօսք ըսել զինք չճանչցողներուն համար։ Ինքս ալ զինք ուշ ճանչցայ, սակայն շատ կարճ ժամանակի մէջ դարձանք երկու եղբայրներու պէս մօտիկ։ Յակոբը կ’ապրէր Ֆրանսայի Լիոն քաղաքը։ Վեց տարիներու</description>
      <guid isPermaLink="false">https://westernarmeniatv.com/society_wa/%d5%a1%d5%b5%d5%bd-%d5%a1%d5%b7%d5%ad%d5%a1%d6%80%d5%b0%d5%a7%d5%b6-%d5%a1%d5%b6%d5%b7%d5%b7%d5%b8%d6%82%d5%af-%d5%b0%d5%a5%d5%bc%d5%a1%d6%81%d5%a1%d5%ae-%d5%a2%d5%a1%d5%b5%d6%81-%d5%b4%d5%b6%d5%a1/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25d5%25a1%25d5%25b5%25d5%25bd-%25d5%25a1%25d5%25b7%25d5%25ad%25d5%25a1%25d6%2580%25d5%25b0%25d5%25a7%25d5%25b6-%25d5%25a1%25d5%25b6%25d5%25b7%25d5%25b7%25d5%25b8%25d6%2582%25d5%25af-%25d5%25b0%25d5%25a5%25d5%25bc%25d5%25a1%25d6%2581%25d5%25a1%25d5%25ae-%25d5%25a2%25d5%25a1%25d5%25b5%25d6%2581-%25d5%25b4%25d5%25b6%25d5%25a1</guid>
      <enclosure url="https://westernarmeniatv.com/wp-content/uploads/2025/12/29114.jpg" length="0" type="image/jpeg"/>
