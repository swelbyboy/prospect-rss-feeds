    <item>
      <title>বইমেলা ও ঈদকে সামনে রেখে এবার ডাবল বোনাস চায় আপামর চাকরিজীবি সমাজ। নইলে আরেকটা গণঅভ্যুত্থানের ডাক দেওয়ার হুঁশিয়ারি</title>
      <link>https://www.earki.co/news/article/11612/%E0%A6%AC%E0%A6%87%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%93-%E0%A6%88%E0%A6%A6%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%A1%E0%A6%BE%E0%A6%AC%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B8-%E0%A6%9A%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%AA%E0%A6%BE%E0%A6%AE%E0%A6%B0</link>
      <description>অমর একুশে বইমেলা আর ঈদুল ফিতর একসাথে এসে চাকরিজীবীদের ফেলেছে দ্বিমুখী অর্থনৈতিক চাপে। বোনাস যদি একটাই হয়, তাহলে বই নাকি শপিং—কোনটা বেছে নেবে তারা? কর্পোরেট পাড়ায় তাই জোর দাবি—এবার চাই ডাবল বোনাস, না হলে বসন্তেই গুঞ্জন উঠতে পারে নতুন গণঅভ্যুত্থানের! বিস্তারিত</description>
      <guid isPermaLink="false">https://www.earki.co/news/article/11612/%E0%A6%AC%E0%A6%87%E0%A6%AE%E0%A7%87%E0%A6%B2%E0%A6%BE-%E0%A6%93-%E0%A6%88%E0%A6%A6%E0%A6%95%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%87-%E0%A6%B0%E0%A7%87%E0%A6%96%E0%A7%87-%E0%A6%8F%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%A1%E0%A6%BE%E0%A6%AC%E0%A6%B2-%E0%A6%AC%E0%A7%8B%E0%A6%A8%E0%A6%BE%E0%A6%B8-%E0%A6%9A%E0%A6%BE%E0%A7%9F-%E0%A6%86%E0%A6%AA%E0%A6%BE%E0%A6%AE%E0%A6%B0</guid>
