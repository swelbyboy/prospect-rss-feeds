    <item>
      <title>Bob Marley: Όταν ο βασιλιάς της reggae έπαιζε ποδόσφαιρο</title>
      <link>https://katerinisport.gr/%cf%8c%cf%84%ce%b1%ce%bd-%ce%bf-%ce%b2%ce%b1%cf%83%ce%b9%ce%bb%ce%b9%ce%ac%cf%82-%cf%84%ce%b7%cf%82-%cf%81%ce%ad%ce%b3%ce%ba%ce%b5-%ce%ad%cf%80%ce%b1%ce%b9%ce%b6%ce%b5-%cf%80%ce%bf%ce%b4%cf%8c%cf%83/</link>
