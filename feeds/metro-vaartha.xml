      <enclosure url="https://media.assettype.com/metrovaartha%2F2025-11-30%2Fjeey52rg%2F1.jpg?w=1200&amp;amp;ar=40%3A21&amp;amp;auto=format%2Ccompress&amp;amp;ogImage=true&amp;amp;mode=crop&amp;amp;enlarge=true&amp;amp;overlay=false&amp;amp;overlay_position=bottom&amp;amp;overlay_width=100" length="0" type="image/jpeg"/>
