    <item>
      <title>Ταξιδιωτικές οδηγίες για τους Έλληνες πολίτες από τις πρεσβείες στη Μέση Ανατολή</title>
      <link>https://www.europolitis.eu/2026/03/01/%cf%84%ce%b1%ce%be%ce%b9%ce%b4%ce%b9%cf%89%cf%84%ce%b9%ce%ba%ce%ad%cf%82-%ce%bf%ce%b4%ce%b7%ce%b3%ce%af%ce%b5%cf%82-%ce%b3%ce%b9%ce%b1-%cf%84%ce%bf%cf%85%cf%82-%ce%ad%ce%bb%ce%bb%ce%b7%ce%bd%ce%b5/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25cf%2584%25ce%25b1%25ce%25be%25ce%25b9%25ce%25b4%25ce%25b9%25cf%2589%25cf%2584%25ce%25b9%25ce%25ba%25ce%25ad%25cf%2582-%25ce%25bf%25ce%25b4%25ce%25b7%25ce%25b3%25ce%25af%25ce%25b5%25cf%2582-%25ce%25b3%25ce%25b9%25ce%25b1-%25cf%2584%25ce%25bf%25cf%2585%25cf%2582-%25ce%25ad%25ce%25bb%25ce%25bb%25ce%25b7%25ce%25bd%25ce%25b5</link>
