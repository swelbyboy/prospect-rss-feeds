      <description>ঝিনাইদহের কালীগঞ্জ উপজেলার মহেশ্বরচাঁদা গ্রামে শিলা খাতুন (২২) নামে এক গৃহবধূর রহস্যজনক মৃত্যু কেন্দ্র করে হাসপাতাল চত্বরে দুই পরিবারের মধ্যে সংঘর্ষের ঘটনা ঘটেছে। নিহতের স্বামী আত্মহত্যার দাবি করলেও শিলার বাবা ও স্বজনরা এটি পরিকল্পিত হত্যাকাণ্ড বলছেন। স্থানীয় ও নিহতের পরিবার সূত্রে জানা যায়, প্রায় দুই বছর আগে মহেশ্বরচাঁদা গ্রামের আব্দুল আলিমের সঙ্গে শিলার বিয়ে হয়। বিয়ের পর থেকেই যৌতুকের দাবিতে... বিস্তারিত</description>
      <guid isPermaLink="false">https://www.ittefaq.com.bd/782455/%E0%A6%95%E0%A6%BE%E0%A6%B2%E0%A7%80%E0%A6%97%E0%A6%9E%E0%A7%8D%E0%A6%9C%E0%A7%87-%E0%A6%97%E0%A7%83%E0%A6%B9%E0%A6%AC%E0%A6%A7%E0%A7%82%E0%A6%B0-%E0%A6%B0%E0%A6%B9%E0%A6%B8%E0%A7%8D%E0%A6%AF%E0%A6%9C%E0%A6%A8%E0%A6%95-%E0%A6%AE%E0%A7%83%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A7%81-%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE%E0%A6%B2-%E0%A6%9A%E0%A6%A4%E0%A7%8D%E0%A6%AC%E0%A6%B0%E0%A7%87</guid>
