    <item>
      <title>উখিয়ায় ৫ রোহিঙ্গা উদ্ধার, দালাল সন্দেহে আটক ১</title>
      <link>https://www.ittefaq.com.bd/782456/%E0%A6%89%E0%A6%96%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A7%AB-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B9%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A7</link>
      <description>কক্সবাজারের উখিয়ায় মালয়েশিয়া পাচারের উদ্দেশ্যে জড়ো করা ৫ রোহিঙ্গাকে উদ্ধার করেছে পুলিশ। এই সময় মানবপাচারকারী চক্রের সঙ্গে জড়িত সন্দেহে সাইফুল ইসলাম (৩৭) নামে এক ব্যক্তিকে আটক করা হয়েছে। বৃহস্পতিবার (২ এপ্রিল) বিকেলে উপজেলার টিএন্ডটি গুচ্ছগ্রাম এলাকার একটি বাড়িতে অভিযান চালিয়ে তাদের উদ্ধার করা হয়। পুলিশ জানায়, গোপন সংবাদের ভিত্তিতে ওই বাড়িতে হানা দিলে দালাল চক্রের সদস্যরা পালিয়ে... বিস্তারিত</description>
      <guid isPermaLink="false">https://www.ittefaq.com.bd/782456/%E0%A6%89%E0%A6%96%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%AF%E0%A6%BC-%E0%A7%AB-%E0%A6%B0%E0%A7%8B%E0%A6%B9%E0%A6%BF%E0%A6%99%E0%A7%8D%E0%A6%97%E0%A6%BE-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%B2-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B9%E0%A7%87-%E0%A6%86%E0%A6%9F%E0%A6%95-%E0%A7%A7</guid>
