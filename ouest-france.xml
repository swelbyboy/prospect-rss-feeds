      <enclosure url="https://media.ouest-france.fr/v1/pictures/MjAyNjAyNjE4MDRmYWExNzYxZDE4NzY0NTE1Mjg3M2RhNDIyOTA?width=320&amp;height=240&amp;focuspoint=50%2C25&amp;cropresize=1&amp;client_id=bpeditorial&amp;sign=d8290cc817f0549ce50d889b107564dbbe6faff2f18552990a9ea525dcb00c93" length="0" type="image/jpeg"/>
