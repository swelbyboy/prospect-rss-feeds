    <item>
      <title>DOJ waves through Nexstar merger despite state anger</title>
      <link>https://globalcompetitionreview.com/gcr-usa/article/doj-waves-through-nexstar-merger-despite-state-anger</link>
      <description>The Department of Justice has allowed Nexstar to buy TV rival Tegna for $6.2 billion, including 11 stations that the Trump Administration once mandated it sell off to prevent higher bills for “millions” of consumers and many small businesses.</description>
      <guid isPermaLink="false">https://globalcompetitionreview.com/gcr-usa/article/doj-waves-through-nexstar-merger-despite-state-anger</guid>
      <enclosure url="https://d2qu5xmcgmzxnb.cloudfront." length="0" type="image/jpeg"/>
