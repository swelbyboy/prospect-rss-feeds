      <enclosure url="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgFGEz3P-gozzn9vhNQLYBxcleUdI2wCMJYOTkXB6DAKIvLGfZqv0ex2ceI-_z6vHN0swcrFgDOmAj7ZSO_l-OXTBWSSLXz4c18UXH7f21uTB3KLykdtgBV9R7MB_W_TDTSlvyvggBQcToo/w1200-h630-p-k-no-nu/1.jpg" length="0" type="image/jpeg"/>
