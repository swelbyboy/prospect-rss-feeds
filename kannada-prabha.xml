      <guid isPermaLink="false">https://www.kannadaprabha.com/nation/2025/Dec/01/oppn-defeat-must-not-turn-into-debate-pm-on-parl-session</guid>
      <enclosure url="https://media.kannadaprabha.com/kannadaprabha%2F2025-12-01%2F7h1w1xq3%2F01live-pm3.webp?w=1200&amp;amp;ar=40%3A21&amp;amp;auto=format%2Ccompress&amp;amp;ogImage=true&amp;amp;mode=crop&amp;amp;enlarge=true&amp;amp;overlay=false&amp;amp;overlay_position=bottom&amp;amp;overlay_width=100" length="0" type="image/jpeg"/>
