    <item>
      <title>Ένας στους δύο Γερμανούς τάσσεται υπέρ της παροχής μεγαλύτερης βοήθειας στην Ουκρανία</title>
      <link>https://www.europolitis.eu/2026/02/08/%ce%ad%ce%bd%ce%b1%cf%82-%cf%83%cf%84%ce%bf%cf%85%cf%82-%ce%b4%cf%8d%ce%bf-%ce%b3%ce%b5%cf%81%ce%bc%ce%b1%ce%bd%ce%bf%cf%8d%cf%82-%cf%84%ce%ac%cf%83%cf%83%ce%b5%cf%84%ce%b1%ce%b9-%cf%85%cf%80%ce%ad/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25ce%25ad%25ce%25bd%25ce%25b1%25cf%2582-%25cf%2583%25cf%2584%25ce%25bf%25cf%2585%25cf%2582-%25ce%25b4%25cf%258d%25ce%25bf-%25ce%25b3%25ce%25b5%25cf%2581%25ce%25bc%25ce%25b1%25ce%25bd%25ce%25bf%25cf%258d%25cf%2582-%25cf%2584%25ce%25ac%25cf%2583%25cf%2583%25ce%25b5%25cf%2584%25ce%25b1%25ce%25b9-%25cf%2585%25cf%2580%25ce%25ad</link>
