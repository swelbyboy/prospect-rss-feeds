      <enclosure url="https://pamukkalehabercom.teimg.com/crop/1280x720/pamukkalehaber-com/uploads/2026/03/s-a-n-a-y-i-b-a-k-a-n-i-d-t-o-n-u-n-t-e-k-n-i-k-t-e-k-s-t-i-l-m-e-r-k-e-z-i-n-i-i-n-c-e-l-e-d-i.jpg" length="0" type="image/jpeg"/>
