    <item>
      <title>ઇઝરાયેલી સૈનિકોએ કાલકિલિયામાંપંદર મહિલાઓનું અપહરણ કર્યું; PPS - Gujarat Today</title>
      <link>https://gujarattoday.in/%e0%aa%87%e0%aa%9d%e0%aa%b0%e0%aa%be%e0%aa%af%e0%ab%87%e0%aa%b2%e0%ab%80-%e0%aa%b8%e0%ab%88%e0%aa%a8%e0%aa%bf%e0%aa%95%e0%ab%8b%e0%aa%8f-%e0%aa%95%e0%aa%be%e0%aa%b2%e0%aa%95%e0%aa%bf%e0%aa%b2%e0%aa%bf/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e0%25aa%2587%25e0%25aa%259d%25e0%25aa%25b0%25e0%25aa%25be%25e0%25aa%25af%25e0%25ab%2587%25e0%25aa%25b2%25e0%25ab%2580-%25e0%25aa%25b8%25e0%25ab%2588%25e0%25aa%25a8%25e0%25aa%25bf%25e0%25aa%2595%25e0%25ab%258b%25e0%25aa%258f-%25e0%25aa%2595%25e0%25aa%25be%25e0%25aa%25b2%25e0%25aa%2595%25e0%25aa%25bf%25e0%25aa%25b2%25e0%25aa%25bf</link>
      <description>(એજન્સી) તા.૨૪પેલેસ્ટીની પ્રિઝનર્સ સોસાયટી (PPS)એ અહેવાલ આપ્યો છે કે ઇઝરાયલી કબજા હેઠળના દળોએ ઉત્તરપશ્ચિમ પશ્ચિમ કાંઠાના કાલકિલિયામાંથી રાત્રે ઓછામાં ઓછી પંદર મહિલાઓનું અપહરણ કર્યું હતું, જેમાંથી મોટાભાગની ભૂતપૂર્વ રાજકીય કેદીઓની પત્નીઓ, વર્તમાન કેદીઓની પત્નીઓ અને ઇઝરાયલી દળો દ્વારા માર્યા ગયેલા પેલેસ્ટીનીની માતાઓ હતી.PPSએ જણાવ્યું હતું કે સામૂહિક અપહરણ એવા સમયે થયું છે જ્યારે ઇઝરાયલ ચાલુ</description>
      <guid isPermaLink="false">https://gujarattoday.in/%e0%aa%87%e0%aa%9d%e0%aa%b0%e0%aa%be%e0%aa%af%e0%ab%87%e0%aa%b2%e0%ab%80-%e0%aa%b8%e0%ab%88%e0%aa%a8%e0%aa%bf%e0%aa%95%e0%ab%8b%e0%aa%8f-%e0%aa%95%e0%aa%be%e0%aa%b2%e0%aa%95%e0%aa%bf%e0%aa%b2%e0%aa%bf/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e0%25aa%2587%25e0%25aa%259d%25e0%25aa%25b0%25e0%25aa%25be%25e0%25aa%25af%25e0%25ab%2587%25e0%25aa%25b2%25e0%25ab%2580-%25e0%25aa%25b8%25e0%25ab%2588%25e0%25aa%25a8%25e0%25aa%25bf%25e0%25aa%2595%25e0%25ab%258b%25e0%25aa%258f-%25e0%25aa%2595%25e0%25aa%25be%25e0%25aa%25b2%25e0%25aa%2595%25e0%25aa%25bf%25e0%25aa%25b2%25e0%25aa%25bf</guid>
      <enclosure url="https://gujarattoday.in/wp-content/uploads/2025/02/GT_LOGO-7.jpg" length="0" type="image/jpeg"/>
