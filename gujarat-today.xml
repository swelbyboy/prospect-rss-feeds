    <item>
      <title>પાકિસ્તાન, સઉદી અરેબિયા, તુર્કી, ઇજિપ્ત ઇરાન યુદ્ધનોકાયમી અંત લાવવાના માર્ગો પર ચર્ચા કરે છે - Gujarat Today</title>
      <link>https://gujarattoday.in/%e0%aa%aa%e0%aa%be%e0%aa%95%e0%aa%bf%e0%aa%b8%e0%ab%8d%e0%aa%a4%e0%aa%be%e0%aa%a8-%e0%aa%b8%e0%aa%89%e0%aa%a6%e0%ab%80-%e0%aa%85%e0%aa%b0%e0%ab%87%e0%aa%ac%e0%aa%bf%e0%aa%af%e0%aa%be-%e0%aa%a4/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e0%25aa%25aa%25e0%25aa%25be%25e0%25aa%2595%25e0%25aa%25bf%25e0%25aa%25b8%25e0%25ab%258d%25e0%25aa%25a4%25e0%25aa%25be%25e0%25aa%25a8-%25e0%25aa%25b8%25e0%25aa%2589%25e0%25aa%25a6%25e0%25ab%2580-%25e0%25aa%2585%25e0%25aa%25b0%25e0%25ab%2587%25e0%25aa%25ac%25e0%25aa%25bf%25e0%25aa%25af%25e0%25aa%25be-%25e0%25aa%25a4</link>
      <description>(એજન્સી) ઇસ્લામાબાદ, તા.૩૦પાકિસ્તાન, સઉદી અરેબિયા, તુર્કી અને ઇજિપ્તે રવિવારે મધ્ય પૂર્વમાં "યુદ્ધનો વહેલો અને કાયમી અંત લાવવાના સંભવિત રસ્તાઓ" પર ચર્ચા કરી હતી, પાકિસ્તાનના વિદેશ પ્રધાન ઇશાક ડારે જણાવ્યું હતું. ઇસ્લામાબાદમાં અમેરિકા-ઈરાન યુદ્ધમાં તણાવ ઓછો કરવા માટે ચારેય રાષ્ટ્રોએ સંયુક્ત વાટાઘાટો કરી. એક વીડિયો રેકોર્ડ કરેલા નિવેદનમાં, ડારે જણાવ્યું હતું કે તમામ પક્ષોએ પાકિસ્તાનની સુવિધામાં</description>
      <guid isPermaLink="false">https://gujarattoday.in/%e0%aa%aa%e0%aa%be%e0%aa%95%e0%aa%bf%e0%aa%b8%e0%ab%8d%e0%aa%a4%e0%aa%be%e0%aa%a8-%e0%aa%b8%e0%aa%89%e0%aa%a6%e0%ab%80-%e0%aa%85%e0%aa%b0%e0%ab%87%e0%aa%ac%e0%aa%bf%e0%aa%af%e0%aa%be-%e0%aa%a4/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e0%25aa%25aa%25e0%25aa%25be%25e0%25aa%2595%25e0%25aa%25bf%25e0%25aa%25b8%25e0%25ab%258d%25e0%25aa%25a4%25e0%25aa%25be%25e0%25aa%25a8-%25e0%25aa%25b8%25e0%25aa%2589%25e0%25aa%25a6%25e0%25ab%2580-%25e0%25aa%2585%25e0%25aa%25b0%25e0%25ab%2587%25e0%25aa%25ac%25e0%25aa%25bf%25e0%25aa%25af%25e0%25aa%25be-%25e0%25aa%25a4</guid>
