    <item>
      <title>ঈদের আমেজ কাটেনি মিরপুরে, চিড়িয়াখানা ও উদ্ভিদ উদ্যানে দর্শনার্থীদের উপচে পড়া ভিড়</title>
      <link>https://ekattor.tv/capital/88570/%E0%A6%88%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A7%87%E0%A6%9C-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A6%BF-%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%93-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AD%E0%A6%BF%E0%A6%A6</link>
      <description>ঈদের আনুষ্ঠানিক ছুটি শেষ হলেও কাটেনি উৎসবের রেশ। রাজধানীর মিরপুরে জাতীয় চিড়িয়াখানা ও জাতীয় উদ্ভিদ উদ্যানে (বোটানিক্যাল গার্ডেন) আজ মঙ্গলবারও (২৪ মার্চ) দেখা গেছে দর্শনার্থীদের উপচে পড়া ভিড়। বিস্তারিত</description>
      <guid isPermaLink="false">https://ekattor.tv/capital/88570/%E0%A6%88%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%AE%E0%A7%87%E0%A6%9C-%E0%A6%95%E0%A6%BE%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A6%BF-%E0%A6%AE%E0%A6%BF%E0%A6%B0%E0%A6%AA%E0%A7%81%E0%A6%B0%E0%A7%87-%E0%A6%9A%E0%A6%BF%E0%A7%9C%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%96%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%93-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AD%E0%A6%BF%E0%A6%A6</guid>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2026/03/24/0952fe301c483e85d69e8657155f8820-69c27ff86a4c3.jpg?jadewits_media_id=50734" length="0" type="image/jpeg"/>
