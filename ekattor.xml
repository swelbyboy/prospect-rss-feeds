    <item>
      <title>ইরানের নতুন নিরাপত্তা প্রধান হলেন জোলকদর</title>
      <link>https://ekattor.tv/international/middle-east/88574/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A7%8B%E0%A6%B2%E0%A6%95%E0%A6%A6%E0%A6%B0</link>
      <description>অভিজ্ঞ সামরিক কমান্ডার ও যুদ্ধকৌশলী মোহাম্মদ বাকের জোলকদর আনুষ্ঠানিকভাবে ইরানের সর্বোচ্চ জাতীয় নিরাপত্তা পরিষদের (এসএনএসসি) নতুন সচিব হিসেবে নিযুক্ত হয়েছেন। মঙ্গলবার ইরান প্রেসিডেন্টের কার্যালয়ের যোগাযোগ ও তথ্য বিষয়ক উপ-প্রধান সাইয়্যেদ মাহদি তাবাতাবায়ি সামাজিক মাধ্যম এক্সে (সাবেক টুইটার) এক পোস্টে এই ঘোষণা দেন। বিস্তারিত</description>
      <guid isPermaLink="false">https://ekattor.tv/international/middle-east/88574/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%A8%E0%A6%A4%E0%A7%81%E0%A6%A8-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A6%BE%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%BE-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8-%E0%A6%9C%E0%A7%8B%E0%A6%B2%E0%A6%95%E0%A6%A6%E0%A6%B0</guid>
