    <item>
      <title>রাজধানীতে পৃথক সড়ক দুর্ঘটনায় কিশোরীসহ নিহত দুই</title>
      <link>https://ekattor.tv/capital/88577/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%83%E0%A6%A5%E0%A6%95-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%A6%E0%A7%81%E0%A6%87</link>
      <description>রাজধানীর রামপুরা ও গাবতলীতে পৃথক সড়ক দুর্ঘটনায় এক কিশোরীসহ দুইজন নিহত হয়েছেন। সোমবার রাতে দুর্ঘটনা দুটি ঘটে। ময়নাতদন্তের জন্য মরদেহ দুটি ঢাকা মেডিকেল কলেজ (ঢামেক) হাসপাতালের মর্গে রাখা হয়েছে। বিস্তারিত</description>
      <guid isPermaLink="false">https://ekattor.tv/capital/88577/%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A7%80%E0%A6%A4%E0%A7%87-%E0%A6%AA%E0%A7%83%E0%A6%A5%E0%A6%95-%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A7%9F-%E0%A6%95%E0%A6%BF%E0%A6%B6%E0%A7%8B%E0%A6%B0%E0%A7%80%E0%A6%B8%E0%A6%B9-%E0%A6%A8%E0%A6%BF%E0%A6%B9%E0%A6%A4-%E0%A6%A6%E0%A7%81%E0%A6%87</guid>
      <enclosure url="https://cdn.ekattorbd.com/contents/cache/images/300x300x1/uploads/media/2023/08/31/efa9a4d14180b397a18914e85e01c7fb-64f09f369db3c.jpg?jadewits_media_id=470" length="0" type="image/jpeg"/>
