    <item>
      <title>ইরানের শুদ্ধি অভিযান, ৯২ ‘বিশ্বাসঘাতক’ গ্রেপ্তার</title>
      <link>https://ekattor.tv/international/middle-east/88571/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BF-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A7%AF%E0%A7%A8-%E2%80%98%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A6%95%E2%80%99-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</link>
      <description>ইসরাইল ও পশ্চিমাদের পৃষ্ঠপোষকতায় পরিচালিত ‘ইরান ইন্টারন্যাশনাল’ নেটওয়ার্কের সঙ্গে জড়িত থাকার অভিযোগে ইরানের নিরাপত্তা বাহিনী ৯০ জনেরও বেশি ব্যক্তিকে গ্রেপ্তার করেছে। ইসরাইল ও আমেরিকার পক্ষ থেকে ইরানের বিরুদ্ধে শুরু হওয়া অঘোষিত যুদ্ধের ২৫তম দিনে এই পদক্ষেপকে শত্রুভাবাপন্ন সংবাদমাধ্যমের বিরুদ্ধে একটি বড় ধরনের অভিযান হিসেবে দেখা হচ্ছে। বিস্তারিত</description>
      <guid isPermaLink="false">https://ekattor.tv/international/middle-east/88571/%E0%A6%87%E0%A6%B0%E0%A6%BE%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%B6%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%BF-%E0%A6%85%E0%A6%AD%E0%A6%BF%E0%A6%AF%E0%A6%BE%E0%A6%A8-%E0%A7%AF%E0%A7%A8-%E2%80%98%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%E0%A6%98%E0%A6%BE%E0%A6%A4%E0%A6%95%E2%80%99-%E0%A6%97%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%AA%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%B0</guid>
