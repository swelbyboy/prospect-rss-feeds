      <title>সিটিকে উড়িয়ে দিল রিয়াল » Business24BD</title>
      <link>https://www.business24bd.com/%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a7%87-%e0%a6%89%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a6%e0%a6%bf%e0%a6%b2-%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e0%25a6%25b8%25e0%25a6%25bf%25e0%25a6%259f%25e0%25a6%25bf%25e0%25a6%2595%25e0%25a7%2587-%25e0%25a6%2589%25e0%25a6%25a1%25e0%25a6%25bc%25e0%25a6%25bf%25e0%25a6%25af%25e0%25a6%25bc%25e0%25a7%2587-%25e0%25a6%25a6%25e0%25a6%25bf%25e0%25a6%25b2-%25e0%25a6%25b0%25e0%25a6%25bf%25e0%25a6%25af%25e0%25a6%25bc%25e0%25a6%25be</link>
      <description>উরুগুয়ের মিডফিল্ডার ফেদেরিকো ভালভের্দের দুর্দান্ত হ্যাটট্রিকে চ্যাম্পিয়ন্স লিগের শেষ ষোলোর প্রথম লেগে সহজ জয় তুলে নিয়েছে রিয়াল মাদ্রিদ। বুধবার সান্তিয়াগো বার্নাব্যুতে ইংলিশ প্রিমিয়ার লিগ ক্লাব ম্যানচেস্টার সিটিকে ৩-০ ব্যবধানে হারায় স্প্যানিশ ক্লাবটি। ম্যাচের আগে বার্নাব্যুতে সমর্থকদের মধ্যে কিছুটা অনিশ্চয়তার আবহ ছিল। রিয়ালের নতুন কোচ আলভারো আরবেলোয়া এখনো পুরোপুরি পরীক্ষিত নন, দলটি টানা দুটি লিগ ম্যাচ</description>
      <guid isPermaLink="false">https://www.business24bd.com/%e0%a6%b8%e0%a6%bf%e0%a6%9f%e0%a6%bf%e0%a6%95%e0%a7%87-%e0%a6%89%e0%a6%a1%e0%a6%bc%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a7%87-%e0%a6%a6%e0%a6%bf%e0%a6%b2-%e0%a6%b0%e0%a6%bf%e0%a6%af%e0%a6%bc%e0%a6%be/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e0%25a6%25b8%25e0%25a6%25bf%25e0%25a6%259f%25e0%25a6%25bf%25e0%25a6%2595%25e0%25a7%2587-%25e0%25a6%2589%25e0%25a6%25a1%25e0%25a6%25bc%25e0%25a6%25bf%25e0%25a6%25af%25e0%25a6%25bc%25e0%25a7%2587-%25e0%25a6%25a6%25e0%25a6%25bf%25e0%25a6%25b2-%25e0%25a6%25b0%25e0%25a6%25bf%25e0%25a6%25af%25e0%25a6%25bc%25e0%25a6%25be</guid>
