    <item>
      <title>যুক্তরাষ্ট্রের সঙ্গে বাণিজ্যচুক্তি বাতিলের দাবি » Business24BD</title>
      <link>https://www.business24bd.com/%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a6%be-4/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e0%25a6%25af%25e0%25a7%2581%25e0%25a6%2595%25e0%25a7%258d%25e0%25a6%25a4%25e0%25a6%25b0%25e0%25a6%25be%25e0%25a6%25b7%25e0%25a7%258d%25e0%25a6%259f%25e0%25a7%258d%25e0%25a6%25b0%25e0%25a7%2587%25e0%25a6%25b0-%25e0%25a6%25b8%25e0%25a6%2599%25e0%25a7%258d%25e0%25a6%2597%25e0%25a7%2587-%25e0%25a6%25ac%25e0%25a6%25be-4</link>
      <description>‘যুক্তরাষ্ট্রের সঙ্গে করা অসম বাণিজ্যচুক্তি বাংলাদেশের অর্থনীতি, সার্বভৌমত্ব ও নিরাপত্তার জন্য হুমকি। দেশের স্বার্থবিরোধী এ চুক্তি বাতিল করতে হবে এবং এর সঙ্গে জড়িতদের শাস্তি নিশ্চিত করতে হবে।’ শনিবার (১৪ মার্চ) রাজধানীর ঢাকা রিপোর্টার্স ইউনিটিতে (ডিআরইউ) বাংলাদেশের কমিউনিস্ট পার্টি (সিপিবি) ঢাকা মহানগর উত্তরের উদ্যোগে ‘আমেরিকার সঙ্গে অসম বাণিজ্য চুক্তি: বাংলাদেশের অর্থনীতি, নিরাপত্তা ও সার্বভৌমত্বের জন্য হুমকি’</description>
      <guid isPermaLink="false">https://www.business24bd.com/%e0%a6%af%e0%a7%81%e0%a6%95%e0%a7%8d%e0%a6%a4%e0%a6%b0%e0%a6%be%e0%a6%b7%e0%a7%8d%e0%a6%9f%e0%a7%8d%e0%a6%b0%e0%a7%87%e0%a6%b0-%e0%a6%b8%e0%a6%99%e0%a7%8d%e0%a6%97%e0%a7%87-%e0%a6%ac%e0%a6%be-4/?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=%25e0%25a6%25af%25e0%25a7%2581%25e0%25a6%2595%25e0%25a7%258d%25e0%25a6%25a4%25e0%25a6%25b0%25e0%25a6%25be%25e0%25a6%25b7%25e0%25a7%258d%25e0%25a6%259f%25e0%25a7%258d%25e0%25a6%25b0%25e0%25a7%2587%25e0%25a6%25b0-%25e0%25a6%25b8%25e0%25a6%2599%25e0%25a7%258d%25e0%25a6%2597%25e0%25a7%2587-%25e0%25a6%25ac%25e0%25a6%25be-4</guid>
