      <enclosure url="https://cdn.taronews.tw/files/2025/12/20251205PHO0046l.jpg" length="0" type="image/jpeg"/>
      <pubDate>Fri, 05 Dec 2025 05:46:09 +0000</pubDate>
    </item>
