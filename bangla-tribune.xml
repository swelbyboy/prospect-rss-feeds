    <item>
      <title>দেশে ‌‘প্রিন্স’ হতাশা, বিদেশে আশা জাগালো ‘রকস্টার’</title>
      <link>https://www.banglatribune.com/entertainment/938972/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E2%80%8C%E2%80%98%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%B8%E2%80%99-%E0%A6%B9%E0%A6%A4%E0%A6%BE%E0%A6%B6%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%86%E0%A6%B6%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E2%80%98%E0%A6%B0%E0%A6%95%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E2%80%99</link>
      <description>ঈদের দিন থেকে হতাশায় ডুবে ছিলো শাকিবিয়ানরা। কারণ, ‘প্রিন্স’ সিনেমার প্রদর্শনে দেশে চলছিলো ভৌতিক জটিলতা। এরমধ্যেই আশার খবর এলো বিদেশ থেকে। জানা গেলো, শাকিব খান নিজেকে পুরনো জটিলতায় আটকে না রেখে পা বাড়ালেন সামনের দিকে। নিশ্চিত হওয়া গেলো, এরমধ্যে মালয়েশিয়ায় শুরু হলো তার নতুন সিনেমা ‘রকস্টার’-এর শুটিং। আসন্ন কোরবানির ঈদ লক্ষ্য করে মঙ্গলবার (২৪ মার্চ) থেকে ছবিটির শুটিং শুরু হয়েছে দেশটিতে। যে... বিস্তারিত</description>
      <guid isPermaLink="false">https://www.banglatribune.com/entertainment/938972/%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E2%80%8C%E2%80%98%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A6%A8%E0%A7%8D%E0%A6%B8%E2%80%99-%E0%A6%B9%E0%A6%A4%E0%A6%BE%E0%A6%B6%E0%A6%BE-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87-%E0%A6%86%E0%A6%B6%E0%A6%BE-%E0%A6%9C%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E2%80%98%E0%A6%B0%E0%A6%95%E0%A6%B8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E2%80%99</guid>
