    <item>
      <title>সাগরে পাওয়া পত্রাবলি।। লিয়ানা বাদর</title>
      <link>https://www.banglatribune.com/literature/special-edition/938979/%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A5%A4%E0%A5%A4-%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%B0</link>
      <description>[লিয়ানা বাদর ফিলিস্তিনি ঔপন্যাসিক, ছোটোগল্পকার এবং সিনেমা পরিচালক। ফিলিস্তিনের লেখকদের মধ্যে তার লেখা সবচেয়ে বেশি অনূদিত হয়েছে। জেরিকো থেকে তিনি ১৯৬৭ সালে নির্বাসিত হন এবং দুনিয়ার বিভিন্ন দেশে বসবাস করে আসছেন। তার পরিচালনায় নির্মিত ডকুমেন্টারি ফিল্‌মের সংখ্যা সাতটি। এই ফিল্মগুলো তাকে বিভিন্ন আন্তর্জাতিক পুরস্কার এনে দিয়েছে। গল্পটি ইংরেজিতে অনুবাদ করেছেন, আইদা বামিয়া ও অমনিয়া আমিন।]এই ছোটো... বিস্তারিত</description>
      <guid isPermaLink="false">https://www.banglatribune.com/literature/special-edition/938979/%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0%E0%A7%87-%E0%A6%AA%E0%A6%BE%E0%A6%93%E0%A7%9F%E0%A6%BE-%E0%A6%AA%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%AC%E0%A6%B2%E0%A6%BF%E0%A5%A4%E0%A5%A4-%E0%A6%B2%E0%A6%BF%E0%A7%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AC%E0%A6%BE%E0%A6%A6%E0%A6%B0</guid>
