    <item>
      <title>‘মব করে’ কনটেন্ট ক্রিয়েটরকে বাড়ি থেকে তুলে নিয়ে পিটিয়ে হত্যা</title>
      <link>https://www.banglatribune.com/country/chitagong/938980/%E2%80%98%E0%A6%AE%E0%A6%AC-%E0%A6%95%E0%A6%B0%E0%A7%87%E2%80%99-%E0%A6%95%E0%A6%A8%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9F%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87</link>
      <description>ব্রাহ্মণবাড়িয়ার কসবা উপজেলায় মব সৃষ্টি করে দ্বীন ইসলাম (৩০) নামের এক কনটেন্ট ক্রিয়েটরকে বাড়ি থেকে তুলে নিয়ে পিটিয়ে হত্যার ঘটনা ঘটেছে। মঙ্গলবার দুপুরে উপজেলার মেহারী ইউনিয়নের শিমরাইল গ্রামে এ ঘটনা ঘটে। নিহত দ্বীন ইসলাম ওই ইউনিয়নের শিমরাইল গ্রামের সফিকুল ইসলামের ছেলে। তিনি সামাজিক যোগাযোগমাধ্যম ফেসবুক ও ইউটিউবে ‘তালাশ ক্রাইম দৃষ্টি’ নামের একটি পেজ পরিচালনা করতেন। মাদক সেবন, মাদক... বিস্তারিত</description>
      <guid isPermaLink="false">https://www.banglatribune.com/country/chitagong/938980/%E2%80%98%E0%A6%AE%E0%A6%AC-%E0%A6%95%E0%A6%B0%E0%A7%87%E2%80%99-%E0%A6%95%E0%A6%A8%E0%A6%9F%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%9F-%E0%A6%95%E0%A7%8D%E0%A6%B0%E0%A6%BF%E0%A7%9F%E0%A7%87%E0%A6%9F%E0%A6%B0%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A1%E0%A6%BC%E0%A6%BF-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%A4%E0%A7%81%E0%A6%B2%E0%A7%87-%E0%A6%A8%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A7%87</guid>
