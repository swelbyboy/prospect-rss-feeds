    <item>
      <title>ঈদের পর প্রথম কর্মদিবসে টানা ১১ ঘণ্টা ব্যস্ত সময় কাটালেন প্রধানমন্ত্রী</title>
      <link>https://www.banglatribune.com/national/938981/%E0%A6%88%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A7%A7%E0%A7%A7-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A6%AE%E0%A7%9F</link>
      <description>পবিত্র ঈদুল ফিতরের ছুটি শেষে প্রথম কর্মদিবসেই টানা প্রায় ১১ ঘণ্টা অফিস করেছেন প্রধানমন্ত্রী তারেক রহমান। মঙ্গলবার (২৪ মার্চ) পবিত্র ঈদুল ফিতরের ছুটির পর ছিল প্রথম কার্যদিবস। প্রথম দিনে প্রধানমন্ত্রী সকাল থেকে রাত পর্যন্ত সচিবালয়ে নিজ দফতরে ব্যস্ত সময় কাটান। প্রধানমন্ত্রীর অতিরিক্ত প্রেস সচিব আতিকুর রহমান রুমন জানান, সকাল ৯টা ১ মিনিটে সচিবালয়ে যান প্রধানমন্ত্রী। দিনভর বিভিন্ন মন্ত্রণালয়ের... বিস্তারিত</description>
      <guid isPermaLink="false">https://www.banglatribune.com/national/938981/%E0%A6%88%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A5%E0%A6%AE-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A6%A6%E0%A6%BF%E0%A6%AC%E0%A6%B8%E0%A7%87-%E0%A6%9F%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A7%A7%E0%A7%A7-%E0%A6%98%E0%A6%A3%E0%A7%8D%E0%A6%9F%E0%A6%BE-%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%B8%E0%A7%8D%E0%A6%A4-%E0%A6%B8%E0%A6%AE%E0%A7%9F</guid>
