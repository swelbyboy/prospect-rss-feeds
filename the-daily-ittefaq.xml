    <item>
      <title>উত্তরাঞ্চলের উদ্যোক্তাদের বিশেষ সুযোগ-সুবিধার আওতায় আনা হবে: ত্রাণমন্ত্রী</title>
      <link>https://www.ittefaq.com.bd/780983/%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B8%E0%A7%81%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A6%BE%E0%A6%B0</link>
      <description>দুর্যোগ ব্যবস্থাপনা ও ত্রাণ মন্ত্রী আসাদুল হাবিব দুলু বলেছেন, উত্তরাঞ্চলে শিল্পায়নের ক্ষেত্রে উদ্যোক্তাদের বিশেষ সুযোগ-সুবিধার আওতায় আনা হবে। রংপুর শস্যের ভাণ্ডার, এখানকার কৃষিকে গুরুত্ব দিয়ে শিল্পায়ন করা হবে। মঙ্গলবার (২৪ মার্চ) বিকালে রংপুর জেলা প্রশাসক সম্মেলন কক্ষে ‘সমতাভিত্তিক আঞ্চলিক উন্নয়ন এবং শিল্পায়ন সম্ভাবনা’ শীর্ষক আলোচনা সভায় প্রধান অতিথির বক্তব্যে তিনি এসব কথা বলেন।... বিস্তারিত</description>
      <guid isPermaLink="false">https://www.ittefaq.com.bd/780983/%E0%A6%89%E0%A6%A4%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%89%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%8B%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A7%87%E0%A6%B7-%E0%A6%B8%E0%A7%81%E0%A6%AF%E0%A7%8B%E0%A6%97-%E0%A6%B8%E0%A7%81%E0%A6%AC%E0%A6%BF%E0%A6%A7%E0%A6%BE%E0%A6%B0</guid>
      <enclosure url="https://cdn.ittefaqbd.com/contents/cache/images/300x300x1/uploads/media/2026/03/24/0093b3b823d72e0d10437cd326d2617c-69c2afa7b6161.jpg?jadewits_media_id=279885" length="0" type="image/jpeg"/>
