    <item>
      <title>যুক্তরাষ্ট্রের আরও একটি এফ-৩৫ যুদ্ধবিমান ভূপাতিত করার দাবি ইরানের</title>
      <link>https://www.ittefaq.com.bd/782459/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%8F%E0%A6%AB-%E0%A7%A9%E0%A7%AB-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AD%E0%A7%82%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%A4</link>
      <description>মধ্য ইরানের আকাশসীমায় যুক্তরাষ্ট্রের আরও একটি অত্যাধুনিক এফ-৩৫ যুদ্ধবিমান ভূপাতিত করার দাবি করেছে ইরানের ইসলামি বিপ্লবী গার্ড কর্পস (আইআরজিসি)। আইআরজিসির সংশ্লিষ্ট ফার্স নিউজ এজেন্সির একটি টেলিগ্রাম পোস্টে জানানো হয়েছে, মার্কিন এই যুদ্ধবিমানটি ধ্বংস হয়ে মাটিতে আছড়ে পড়েছে। বিমানের ব্যাপক ক্ষয়ক্ষতির কারণে পাইলটের বিষয়ে তাৎক্ষণিকভাবে কোনো তথ্য পাওয়া সম্ভব হয়নি বলে ওই বার্তায় উল্লেখ করা... বিস্তারিত</description>
      <guid isPermaLink="false">https://www.ittefaq.com.bd/782459/%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%B7%E0%A7%8D%E0%A6%9F%E0%A7%8D%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%86%E0%A6%B0%E0%A6%93-%E0%A6%8F%E0%A6%95%E0%A6%9F%E0%A6%BF-%E0%A6%8F%E0%A6%AB-%E0%A7%A9%E0%A7%AB-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A6%AC%E0%A6%BF%E0%A6%AE%E0%A6%BE%E0%A6%A8-%E0%A6%AD%E0%A7%82%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%A4</guid>
