    <item>
      <title>প্রতিরক্ষামন্ত্রী হেগসেথের ওপর যুদ্ধের দায়ভার চাপানোর চেষ্টা করছেন ট্রাম্প</title>
      <link>https://www.ittefaq.com.bd/780985/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%B9%E0%A7%87%E0%A6%97%E0%A6%B8%E0%A7%87%E0%A6%A5%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%AD%E0%A6%BE%E0%A6%B0</link>
      <description>ইরানে হামলার দায় প্রতিরক্ষামন্ত্রী পিট হেগসেথের ওপর চাপানোর আভাস দিয়েছেন যুক্তরাষ্ট্রের প্রেসিডেন্ট ডোনাল্ড ট্রাম্প। ইরানের বিষয়ে ট্রাম্পের প্রস্তাবে প্রথম সমর্থন দিয়েছিলেন মার্কিন প্রতিরক্ষামন্ত্রী পিট হেগসেথ। ট্রাম্প বলেন, তার প্রশাসনের সদস্যদের মধ্যে হেগসেথই প্রথম তাকে ইরানে হামলার পরামর্শ দিয়েছিলেন। সোমবার (২৩ মার্চ) টেনেসি অঙ্গরাজ্যের মেমফিসে ‘সেফ টাস্ক ফোর্সের’ এক গোলটেবিল বৈঠকে... বিস্তারিত</description>
      <guid isPermaLink="false">https://www.ittefaq.com.bd/780985/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A4%E0%A6%BF%E0%A6%B0%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%BE%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80-%E0%A6%B9%E0%A7%87%E0%A6%97%E0%A6%B8%E0%A7%87%E0%A6%A5%E0%A7%87%E0%A6%B0-%E0%A6%93%E0%A6%AA%E0%A6%B0-%E0%A6%AF%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A7%9F%E0%A6%AD%E0%A6%BE%E0%A6%B0</guid>
